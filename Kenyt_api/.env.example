# Wialon / Control-Tech login (use a freshly rotated password — see note below)
WIALON_LOGIN=anne@kenytinternational.com
WIALON_PASSWORD=change-me

# Postgres connection (same DB as kenyt-ops-api)
DATABASE_URL=postgresql://user:password@localhost:5432/kenyt_ops

# How often to poll for positions, in minutes
POLL_INTERVAL_MINUTES=3

# NOTE: rotate WIALON_PASSWORD on Control-Tech before deploying this,
# since the current one was shared in a chat/screenshot during setup.
