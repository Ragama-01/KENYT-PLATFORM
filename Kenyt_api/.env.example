# Wialon / Control-Tech login (use a freshly rotated password — see note below)
WIALON_LOGIN=anne@kenytinternational.com
WIALON_PASSWORD=change-me

# Control-Tech tracking
CONTROLTECH_URL=https://track3.controltech-ea.com/
CONTROLTECH_USERNAME=anne@kenytinternational.com
CONTROLTECH_PASSWORD=change-me

# Postgres connection (same DB as kenyt-ops-api)
DATABASE_URL=postgresql://user:password@localhost:5432/kenyt_int

# API server port
PORT=4000

# How often to poll for positions, in minutes
POLL_INTERVAL_MINUTES=3

# SendGrid Email Notifications
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@kenytinternational.com
SUPER_USER_EMAIL=superuser@example.com
TEAM_NOTIFICATION_EMAILS=user1@example.com,user2@example.com

# NOTE: rotate WIALON_PASSWORD (and CONTROLTECH_PASSWORD) on Control-Tech
# before deploying this, since the current one was shared in a chat/screenshot
# during setup.