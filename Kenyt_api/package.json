{
  "name": "kenyt-api",
  "version": "1.0.0",
  "description": "Kenyt International backend API (Fastify + Prisma)",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "reset-admin": "tsx scripts/resetAdminPassword.ts",
    "wialon:once": "tsx src/scripts/fetchTruckLocations.ts --once",
    "wialon:poll": "tsx src/scripts/fetchTruckLocations.ts",
    "wialon:map": "tsx src/scripts/mapControlTechUnits.ts",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed-locations": "tsx prisma/seedLocations.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@prisma/client": "^5.20.0",
    "@sendgrid/mail": "^8.1.6",
    "@types/bcrypt": "^6.0.0",
    "axios": "^1.7.7",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "prisma": "^5.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
