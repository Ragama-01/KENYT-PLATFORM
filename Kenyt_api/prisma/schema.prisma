generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TruckStatus {
  available
  assigned
  in_transit
  maintenance
}

enum DriverStatus {
  active
  on_leave
  exited
}

enum ComplianceType {
  insurance
  inspection
  speed_governor
}

model Truck {
  truckId                    Int         @id @default(autoincrement()) @map("truckid")
  registration_number        String
  year_of_manufacture        Int
  capacity_tonnes            Decimal?    @db.Decimal(5, 2)
  logbook_number             String?     @map("logbook_number")
  status                     TruckStatus

  // Truck insurance
  truck_insurance_issued      DateTime?   @db.Date
  truck_insurance_expiry      DateTime?   @db.Date
  truck_insurance_ref         String?
  truck_insurance_serial      String?     @map("truck_insurance_serial")
  truck_insurance_purchase    DateTime?   @map("truck_insurance_purchase") @db.Date

  // TGL (Tracking/Geo-location)
  tgl_number                  String?     @map("tgl_number")
  tgl_year                    String?     @map("tgl_year")

  // Inspection
  inspection_issued           DateTime?   @db.Date
  inspection_expiry           DateTime?   @db.Date
  inspection_cert_number      String?     @map("inspection_cert_number")

  // Speed governor
  speed_governor_issued       DateTime?   @db.Date
  speed_governor_expiry       DateTime?   @db.Date

  // COMESA
  truck_comesa_policy_number  String?
  truck_comesa_insurer        String?
  truck_comesa_date_taken     DateTime?   @db.Date
  truck_comesa_date_expiry    DateTime?   @db.Date
  truck_comesa_premium_amount Decimal?    @db.Decimal(12, 2)

  // Notes
  factors_to_note             String?     @map("factors_to_note")

  created_at                  DateTime    @default(now()) @db.Timestamp(3)
  updated_at                  DateTime    @updatedAt @db.Timestamp(3)

  controlTechUnitId           Int?        @unique @map("control_tech_unit_id")

  compliance                  TruckCompliance[]
  drivers                     Driver[]
  allocations                 Allocation[]
  location                    TruckLocation?
  trailer                     Trailer?
  containers                  Container[]
  insuranceHistory            TruckInsuranceHistory[]
  tglHistory                  TruckTGLHistory[]
  inspectionHistory           TruckInspectionHistory[]

  @@index([status])
  @@index([capacity_tonnes])
  @@map("trucks")
}

model Trailer {
  trailerId            Int       @id @default(autoincrement()) @map("trailer_id")
  truckId              Int       @unique @map("truck_id")

  registration_number  String?
  logbook_number       String?   @map("logbook_number")

  insurance_issued     DateTime? @map("insurance_issued") @db.Date
  insurance_expiry     DateTime? @map("insurance_expiry") @db.Date
  insurance_ref        String?   @map("insurance_ref")

  comesa_policy_number  String?   @map("comesa_policy_number")
  comesa_insurer        String?   @map("comesa_insurer")
  comesa_date_taken     DateTime? @map("comesa_date_taken") @db.Date
  comesa_date_expiry    DateTime? @map("comesa_date_expiry") @db.Date
  comesa_premium_amount Decimal?  @map("comesa_premium_amount") @db.Decimal(12, 2)

  created_at           DateTime  @default(now()) @db.Timestamp(3)
  updated_at           DateTime  @updatedAt @db.Timestamp(3)

  truck                Truck     @relation(fields: [truckId], references: [truckId], onDelete: Cascade)
  insuranceHistory     TrailerInsuranceHistory[]
  comesaHistory        TrailerCOMESAHistory[]

  @@index([truckId])
  @@map("trailers")
}

model TruckCompliance {
  complianceId   Int            @id @default(autoincrement()) @map("compliance_id")
  truckId        Int            @map("truck_id")
  complianceType ComplianceType @map("compliance_type")
  issuedDate     DateTime       @map("issued_date") @db.Date
  expiryDate     DateTime       @map("expiry_date") @db.Date
  documentRef    String?        @map("document_ref")
  isCurrent      Boolean        @default(true) @map("is_current")
  createdAt      DateTime       @default(now()) @map("created_at")

  truck          Truck          @relation(fields: [truckId], references: [truckId], onDelete: Cascade)

  @@map("truck_compliance")
}

// History tables for certificate renewals
model TruckInsuranceHistory {
  id                   Int       @id @default(autoincrement())
  truckId              Int       @map("truck_id")
  policyNumber         String?   @map("policy_number")
  serialNumber         String?   @map("serial_number")
  insurer              String?
  issuedDate           DateTime  @map("issued_date") @db.Date
  expiryDate           DateTime  @map("expiry_date") @db.Date
  purchaseDate         DateTime? @map("purchase_date") @db.Date
  premiumAmount        Decimal?  @db.Decimal(12, 2)
  notes                String?
  createdAt            DateTime  @default(now()) @map("created_at")

  truck                Truck     @relation(fields: [truckId], references: [truckId], onDelete: Cascade)

  @@index([truckId])
  @@map("truck_insurance_history")
}

model TruckTGLHistory {
  id             Int       @id @default(autoincrement())
  truckId        Int       @map("truck_id")
  tglNumber      String?   @map("tgl_number")
  tglYear        String?   @map("tgl_year")
  issuedDate     DateTime? @map("issued_date") @db.Date
  expiryDate     DateTime? @map("expiry_date") @db.Date
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")

  truck          Truck     @relation(fields: [truckId], references: [truckId], onDelete: Cascade)

  @@index([truckId])
  @@map("truck_tgl_history")
}

model TruckInspectionHistory {
  id               Int       @id @default(autoincrement())
  truckId          Int       @map("truck_id")
  certNumber       String?   @map("cert_number")
  inspectionBody   String?   @map("inspection_body")
  issuedDate       DateTime  @map("issued_date") @db.Date
  expiryDate       DateTime  @map("expiry_date") @db.Date
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")

  truck            Truck     @relation(fields: [truckId], references: [truckId], onDelete: Cascade)

  @@index([truckId])
  @@map("truck_inspection_history")
}

model TrailerInsuranceHistory {
  id             Int       @id @default(autoincrement())
  trailerId      Int       @map("trailer_id")
  policyNumber   String?   @map("policy_number")
  insurer        String?
  issuedDate     DateTime  @map("issued_date") @db.Date
  expiryDate     DateTime  @map("expiry_date") @db.Date
  premiumAmount  Decimal?  @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")

  trailer        Trailer   @relation(fields: [trailerId], references: [trailerId], onDelete: Cascade)

  @@index([trailerId])
  @@map("trailer_insurance_history")
}

model TrailerCOMESAHistory {
  id             Int       @id @default(autoincrement())
  trailerId      Int       @map("trailer_id")
  policyNumber   String?   @map("policy_number")
  insurer        String?
  dateTaken      DateTime? @map("date_taken") @db.Date
  dateExpiry     DateTime? @map("date_expiry") @db.Date
  premiumAmount  Decimal?  @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")

  trailer        Trailer   @relation(fields: [trailerId], references: [trailerId], onDelete: Cascade)

  @@index([trailerId])
  @@map("trailer_comesa_history")
}

model Driver {
  driverId      Int          @id @default(autoincrement()) @map("driver_id")
  fullName      String       @map("full_name")
  idNumber      String       @unique @map("id_number")
  truckId       Int?         @map("truck_id")
  dateOfJoining DateTime     @map("date_of_joining") @db.Date
  status        DriverStatus @default(active)

  kraPin      String @unique @map("kra_pin")
  kpaId       String? @unique @map("kpa_id")
  phoneNumber String @unique @map("phone_number")
  email       String @unique
  nssfNumber  String @unique @map("nssf_number")
  shifNumber  String @unique @map("shif_number")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  truck Truck? @relation(fields: [truckId], references: [truckId], onDelete: SetNull)

  @@map("drivers")
}

model TruckLocation {
  truckId   Int      @id @map("truck_id")
  lat       Decimal  @db.Decimal(9, 6)
  lng       Decimal  @db.Decimal(9, 6)
  asOf      DateTime @map("as_of")
  updatedAt DateTime @updatedAt @map("updated_at")

  truck Truck @relation(fields: [truckId], references: [truckId], onDelete: Cascade)

  @@index([lat, lng])
  @@map("truck_locations")
}

model Order {
  orderId Int @id @default(autoincrement())

  bolNumber String? @unique

  customerName String

  cargoWeightTonnes Decimal @db.Decimal(8, 2)

  cargoType String

  loadType String

  containerNumber String?
  containerType   String?

  pickupLocationId Int

  pickupLocation Location @relation("PickupLocation", fields: [pickupLocationId], references: [locationId])

  deliveryLocationId Int

  deliveryLocation Location @relation("DeliveryLocation", fields: [deliveryLocationId], references: [locationId])

  consigneeName  String
  consigneePhone String?

  freeStorageDays Int?

  etaDischargeDate DateTime? @map("eta_discharge_date") @db.Date

  documentationStatus String? @map("documentation_status")

  gfDoType String? @map("gf_do_type")
  gfDoDocument String? @map("gf_do_document")
  gfDoDocumentName String? @map("gf_do_document_name")

  im4Im7Type String? @map("im4_im7_type")
  im4Im7Document String? @map("im4_im7_document")
  im4Im7DocumentName String? @map("im4_im7_document_name")

  priority String @default("normal")

  specialInstructions String?

  status String @default("pending")

  createdAt DateTime @default(now())

  allocations Allocation[]
  containers Container[]

  @@index([status])
  @@index([pickupLocationId])
  @@index([deliveryLocationId])
}

model Container {
  containerId   Int     @id @default(autoincrement()) @map("container_id")
  orderId      Int     @map("order_id")
  containerNumber String @map("container_number")
  containerType String? @map("container_type")
  weightTonnes Decimal @map("weight_tonnes") @db.Decimal(8, 2)
  cargoType   String  @map("cargo_type")

  truckId Int? @map("truck_id")

  order Order @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  truck Truck? @relation(fields: [truckId], references: [truckId], onDelete: SetNull)

  @@index([orderId])
  @@index([truckId])
  @@map("containers")
}

model Allocation {
  allocationId Int @id @default(autoincrement())

  orderId Int
  truckId Int

  allocatedAt DateTime @default(now())
  arrivedAt   DateTime?

  allocatedBy String?

  status String @default("allocated")

  order Order @relation(fields: [orderId], references: [orderId])

  truck Truck @relation(fields: [truckId], references: [truckId])

  @@index([orderId])
  @@index([truckId])
  @@map("allocations")
}

model Location {
  locationId Int @id @default(autoincrement())

  name String @unique

  latitude  Decimal @db.Decimal(9, 6)
  longitude Decimal @db.Decimal(9, 6)

  type String

  pickupOrders   Order[] @relation("PickupLocation")
  deliveryOrders Order[] @relation("DeliveryLocation")

  @@index([name])
  @@map("locations")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String   @db.Text
  fullName  String   @map("full_name")
  role      String   @default("user") // "admin" | "user"
  isActive  Boolean  @default(true) @map("is_active")
  lastLogin DateTime? @map("last_login")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@index([role])
  @@map("users")
}

model Customer {
  customerId    Int      @id @default(autoincrement()) @map("customer_id")
  name          String   @unique
  contactName   String?  @map("contact_person")
  phone         String?
  email         String?
  address       String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("customers")
}